# binary artefacts: never subject to line-ending conversion
*.pt binary
*.gz binary
data/** binary
cluster/checkpoints/*.pt binary

# the three files over GitHub's 100 MB limit go through Git LFS
data/cifar-10-python.tar.gz filter=lfs diff=lfs merge=lfs -text
data/cifar-100-python.tar.gz filter=lfs diff=lfs merge=lfs -text
data/cifar-100-python/train filter=lfs diff=lfs merge=lfs -text
