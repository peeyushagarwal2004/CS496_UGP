# Everything the project produced is tracked: code, results, trained weights, the
# CIFAR datasets, logs, and a mirror of the GPU cluster's outputs in cluster/.
# Only regenerable environment and cache files are left out.

# Python environment: its torch binaries exceed GitHub's 100 MB file limit and
# are platform-specific. Recreate it from requirements.txt instead.
.venv/

# caches Python and pytest regenerate on every run
__pycache__/
*.pyc
.pytest_cache/

# LaTeX intermediate files (the built report.pdf is tracked)
docs/*.aux
docs/*.log
docs/*.out
docs/*.toc
docs/*.lof
docs/*.lot
texput.log
study_guide/*.aux
study_guide/*.log
study_guide/*.out
study_guide/*.toc
study_guide/main.pdf

# live control files for the sweep runners: a committed STOP would halt every
# rerun after a clone, and a lock would block it
logs/STOP*
logs/sweep.lock
cluster/logs/STOP*
