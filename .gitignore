# Tracked: the library, experiment scripts, tests, every trained network and raw
# campaign output, the reports and figures, and a mirror of the GPU cluster's
# networks and results in cluster/. Left out: anything that is downloaded,
# regenerated, personal, or superseded.

# CIFAR-10/100: torchvision downloads them into data/ on first use
data/

# run logs and the live STOP/lock control files of the sweep runners
logs/
cluster/logs/

# superseded outputs (pre-NaN-fix activation campaigns), personal study notes,
# and third-party papers
cluster/archive/
study_guide/
papers/
scripts/logs_wait_then_sweep.sh

# Python environment: its torch binaries exceed GitHub's 100 MB file limit and
# are platform-specific. Recreate it from requirements.txt instead.
.venv/

# caches Python and pytest regenerate on every run
__pycache__/
*.pyc
.pytest_cache/

# LaTeX intermediate files (the built report.pdf is tracked)
docs/*.aux
docs/*.log
docs/*.out
docs/*.toc
docs/*.lof
docs/*.lot
texput.log
docs/ugp_report/*.aux
docs/ugp_report/*.log
docs/ugp_report/*.out
docs/ugp_report/*.toc
